<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyVersion>3.2.0.0</AssemblyVersion>
    <FileVersion>3.2.0.0</FileVersion>

    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- FFmpeg bindings -->
    <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />

    <!-- SSH -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />

    <!-- Audio -->
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

  <!-- FFmpeg native DLLs and tools.
       Globbed rather than listed by name: the soname major changes with
       every FFmpeg release (avcodec-60 -> 63, swscale-7 -> 10, ...), so a
       hand-written list silently ships nothing after an upgrade. -->
  <ItemGroup>
    <Content Include="av*.dll;sw*.dll;postproc-*.dll;ffmpeg.exe;ffplay.exe;ffprobe.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <!-- Themes -->
  <ItemGroup>
    <Content Include="Themes\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Documentation -->
  <ItemGroup>
    <Content Include="README.md">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="LICENSE">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="THIRDPARTYLICENSES\**\*">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>