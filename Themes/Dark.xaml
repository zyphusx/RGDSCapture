<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════════
         RGDSCapture — fallback palette (colors only; styles live in
         Controls.xaml).

         THIS FILE IS NOT THE RUNTIME THEME. At startup ThemeService
         replaces merged dictionary index 0 with a palette generated by
         PaletteBuilder from the preset in ThemeCatalog. This dictionary
         only serves the XAML designer and the instant before that swap.

         It does, however, define the complete key contract: any key added
         here must also be emitted by PaletteBuilder, and vice versa, or
         some theme will resolve a missing brush at runtime.

         Values below mirror the "Midnight" preset.
    ════════════════════════════════════════════════════════════════ -->

    <!-- ── Surface ramp ────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BackdropBg"        Color="#0E0F12"/>
    <SolidColorBrush x:Key="WindowBg"          Color="#0E0F12"/>
    <SolidColorBrush x:Key="SurfaceBg"         Color="#16181D"/>
    <SolidColorBrush x:Key="SurfaceRaisedBg"   Color="#1E2127"/>
    <SolidColorBrush x:Key="SurfaceHoverBg"    Color="#252932"/>
    <SolidColorBrush x:Key="VideoAreaBg"       Color="#0A0B0D"/>

    <!-- Aliases kept so dialogs / drawer keep resolving -->
    <SolidColorBrush x:Key="ToolbarBg"         Color="#16181D"/>
    <SolidColorBrush x:Key="ToolbarBorder"     Color="#262A32"/>
    <SolidColorBrush x:Key="PanelBg"           Color="#16181D"/>
    <SolidColorBrush x:Key="PanelBorder"       Color="#262A32"/>
    <SolidColorBrush x:Key="HeaderBg"          Color="#1E2127"/>
    <SolidColorBrush x:Key="SeparatorBg"       Color="#262A32"/>

    <!-- ── Borders ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BorderSubtle"      Color="#262A32"/>
    <SolidColorBrush x:Key="BorderStrong"      Color="#333945"/>

    <!-- ── Typography ──────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TextPrimary"       Color="#E6E9EF"/>
    <SolidColorBrush x:Key="TextSecondary"     Color="#9AA3B2"/>
    <SolidColorBrush x:Key="TextTertiary"      Color="#6F7787"/>
    <SolidColorBrush x:Key="TextDisabled"      Color="#5A6272"/>

    <!-- ── Accent ──────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="AccentBg"          Color="#4C8DFF"/>
    <SolidColorBrush x:Key="AccentHover"       Color="#6BA1FF"/>
    <SolidColorBrush x:Key="AccentPress"       Color="#3B76E0"/>
    <SolidColorBrush x:Key="AccentFg"          Color="#0B1020"/>
    <SolidColorBrush x:Key="AccentMuted"       Color="#1C2A44"/>
    <SolidColorBrush x:Key="AccentSubtleFg"    Color="#8FB8FF"/>
    <!-- Accent outline treatment. Every theme gets a dimmed-accent outline and
         a matching glow; pride themes swap the flat brushes for their flag's
         stripes at runtime. -->
    <SolidColorBrush x:Key="AccentGradient"    Color="#4C8DFF"/>
    <SolidColorBrush x:Key="AccentOutline"     Color="#164798"/>
    <SolidColorBrush x:Key="AccentSelBg"       Color="#2E3A52"/>
    <DropShadowEffect x:Key="AccentGlowEffect"
                      Color="#4C8DFF"
                      BlurRadius="14"
                      ShadowDepth="0"
                      Opacity="0.55"
                      RenderingBias="Performance"/>

    <!-- ── Semantic status ─────────────────────────────────────── -->
    <SolidColorBrush x:Key="LiveFg"            Color="#34D399"/>
    <SolidColorBrush x:Key="LiveMuted"         Color="#17342A"/>
    <SolidColorBrush x:Key="WarnFg"            Color="#FBBF24"/>
    <SolidColorBrush x:Key="WarnMuted"         Color="#3A2E12"/>
    <SolidColorBrush x:Key="DangerFgSolid"     Color="#FF4D4D"/>
    <SolidColorBrush x:Key="IdleFg"            Color="#6F7787"/>

    <!-- ── Buttons ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BtnBg"             Color="#1E2127"/>
    <SolidColorBrush x:Key="BtnHover"          Color="#282C35"/>
    <SolidColorBrush x:Key="BtnPress"          Color="#313641"/>
    <SolidColorBrush x:Key="BtnBorder"         Color="#333945"/>
    <SolidColorBrush x:Key="BtnFg"             Color="#E6E9EF"/>

    <SolidColorBrush x:Key="DangerBg"          Color="#2A1618"/>
    <SolidColorBrush x:Key="DangerHover"       Color="#3A1D20"/>
    <SolidColorBrush x:Key="DangerPress"       Color="#482427"/>
    <SolidColorBrush x:Key="DangerBorder"      Color="#5A2A2E"/>
    <SolidColorBrush x:Key="DangerFg"          Color="#FF8A8A"/>

    <!-- Active-recording fill -->
    <SolidColorBrush x:Key="RecordingBg"       Color="#C22B2B"/>
    <SolidColorBrush x:Key="RecordingHover"    Color="#D63838"/>
    <SolidColorBrush x:Key="RecordingBorder"   Color="#E05252"/>
    <SolidColorBrush x:Key="RecordingFg"       Color="#FFFFFF"/>

    <!-- ── Inputs ──────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="InputBg"           Color="#111318"/>
    <SolidColorBrush x:Key="InputFg"           Color="#E6E9EF"/>
    <SolidColorBrush x:Key="InputBorder"       Color="#333945"/>
    <SolidColorBrush x:Key="InputBorderHover"  Color="#414958"/>
    <SolidColorBrush x:Key="InputBorderFocus"  Color="#4C8DFF"/>
    <SolidColorBrush x:Key="InputCaret"        Color="#4C8DFF"/>

    <!-- ── Segmented / toggle chips ────────────────────────────── -->
    <SolidColorBrush x:Key="SegmentTrackBg"    Color="#111318"/>
    <SolidColorBrush x:Key="SegmentBorder"     Color="#262A32"/>
    <SolidColorBrush x:Key="SegmentHoverBg"    Color="#1E2127"/>
    <SolidColorBrush x:Key="SegmentSelBg"      Color="#2E3A52"/>
    <SolidColorBrush x:Key="SegmentSelBorder"  Color="#4C8DFF"/>
    <SolidColorBrush x:Key="SegmentSelFg"      Color="#C7DBFF"/>
    <SolidColorBrush x:Key="SegmentFg"         Color="#9AA3B2"/>

    <!-- ── Title bar ───────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TitleBarBg"        Color="#0E0F12"/>
    <SolidColorBrush x:Key="TitleBarBorder"    Color="#20242B"/>
    <SolidColorBrush x:Key="TitleBarFg"        Color="#E6E9EF"/>
    <SolidColorBrush x:Key="CaptionBtnHover"   Color="#252932"/>
    <SolidColorBrush x:Key="CaptionBtnPress"   Color="#2F343E"/>
    <SolidColorBrush x:Key="CaptionCloseHover" Color="#C42B1C"/>
    <SolidColorBrush x:Key="CaptionClosePress" Color="#A02318"/>

    <!-- ── Menus ───────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="MenuBg"            Color="#0E0F12"/>
    <SolidColorBrush x:Key="MenuFg"            Color="#C3CAD6"/>
    <SolidColorBrush x:Key="MenuBorder"        Color="#20242B"/>
    <SolidColorBrush x:Key="MenuPopupBg"       Color="#1A1D23"/>
    <SolidColorBrush x:Key="MenuHoverBg"       Color="#282C35"/>
    <SolidColorBrush x:Key="MenuSeparator"     Color="#2C313A"/>

    <!-- ── Status strip ────────────────────────────────────────── -->
    <SolidColorBrush x:Key="StatusBarBg"       Color="#0B0C0F"/>
    <SolidColorBrush x:Key="StatusBarBorder"   Color="#20242B"/>
    <SolidColorBrush x:Key="StatusFg"          Color="#9AA3B2"/>
    <SolidColorBrush x:Key="StatusErrorFg"     Color="#FF8A8A"/>

    <!-- ── Video panels ────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ScreenBg"          Color="#000000"/>
    <SolidColorBrush x:Key="ScreenBorder"      Color="#242830"/>
    <SolidColorBrush x:Key="ScreenBorderLive"  Color="#2B3A4C"/>
    <SolidColorBrush x:Key="ScreenLabelFg"     Color="#3A414E"/>
    <SolidColorBrush x:Key="ScreenGlassBg"     Color="#B3000000"/>
    <SolidColorBrush x:Key="ScreenGlassBorder" Color="#26FFFFFF"/>

    <!-- ── Log drawer ──────────────────────────────────────────── -->
    <SolidColorBrush x:Key="LogBg"             Color="#0B0C0F"/>
    <SolidColorBrush x:Key="LogFg"             Color="#A9B4C4"/>
    <SolidColorBrush x:Key="LogErrorFg"        Color="#FF8A8A"/>
    <SolidColorBrush x:Key="LogTimestampFg"    Color="#5A6272"/>

    <!-- ── Speedrun timer ──────────────────────────────────────── -->
    <SolidColorBrush x:Key="TimerBg"           Color="#111318"/>
    <SolidColorBrush x:Key="TimerBorder"       Color="#262A32"/>
    <SolidColorBrush x:Key="TimerFg"           Color="#E6E9EF"/>
    <SolidColorBrush x:Key="TimerRunningFg"    Color="#34D399"/>

    <!-- ── VU meter ────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="VuBg"              Color="#111318"/>
    <SolidColorBrush x:Key="VuBorder"          Color="#262A32"/>

    <!-- ── Misc controls ───────────────────────────────────────── -->
    <SolidColorBrush x:Key="SliderTrackBg"     Color="#2C313A"/>
    <SolidColorBrush x:Key="ScrollThumb"       Color="#333945"/>
    <SolidColorBrush x:Key="ScrollThumbHover"  Color="#454D5C"/>
    <SolidColorBrush x:Key="FocusRing"         Color="#4C8DFF"/>
    <SolidColorBrush x:Key="TooltipBg"         Color="#1A1D23"/>
    <SolidColorBrush x:Key="TooltipFg"         Color="#E6E9EF"/>
    <SolidColorBrush x:Key="TooltipBorder"     Color="#333945"/>

    <!-- ── Overlay buttons on video ────────────────────────────── -->
    <SolidColorBrush x:Key="OverlayBtnBg"      Color="#99000000"/>
    <SolidColorBrush x:Key="OverlayBtnHover"   Color="#CC000000"/>
    <SolidColorBrush x:Key="OverlayBtnBorder"  Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="OverlayBtnFg"      Color="#FFFFFF"/>

</ResourceDictionary>
