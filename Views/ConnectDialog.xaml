<Window x:Class="RGDSCapture.Views.ConnectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!-- Borderless card so the dialog matches the main window's chrome.
         The header doubles as the drag handle (see code-behind). -->
    <Border Background="{DynamicResource SurfaceBg}"
            BorderBrush="{DynamicResource BorderStrong}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="12"
            LayoutTransform="{DynamicResource UiScaleTransform}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <!-- Scrolls if a large UI scale (or a short screen) makes the card
             taller than the work area MaxHeight allows. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <Border x:Name="DragHandle" Background="Transparent" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="SSH Credentials"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Sign in to the console to start streaming."
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="12"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtUsername" Margin="0,0,0,14"/>

            <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="TxtPassword" Margin="0,0,0,16"/>

            <CheckBox x:Name="ChkRemember"
                      Content="Remember credentials on this PC"
                      FontSize="12"
                      Margin="0,0,0,22"
                      ToolTip="The password is encrypted with Windows DPAPI and can only be read by your Windows account on this machine"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Width="92"
                        IsCancel="True"
                        Margin="0,0,8,0"/>
                <Button Content="Connect"
                        Width="92"
                        Style="{StaticResource AccentButton}"
                        IsDefault="True"
                        Click="BtnConnect_Click"/>
            </StackPanel>

        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
