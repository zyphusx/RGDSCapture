<UserControl x:Class="RGDSCapture.Views.Controls.LogDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext: MainViewModel. Slides in over the video stage from
         the right edge, so it never resizes the picture underneath. -->
    <Border Width="320"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Background="{DynamicResource SurfaceBg}"
            BorderBrush="{DynamicResource BorderStrong}"
            BorderThickness="1,0,0,0"
            Panel.ZIndex="10"
            AutomationProperties.Name="Event log drawer">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.4" Color="#000000"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform X="321"/>
        </Border.RenderTransform>
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Log.IsOpen}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                        To="0" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                        To="321" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseIn"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource SurfaceRaisedBg}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    Padding="14,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource IconButton}"
                            Content="✕"
                            Command="{Binding Log.ToggleCommand}"
                            AutomationProperties.Name="Close log"
                            ToolTip="Close the log  (F8)"/>
                    <TextBlock Text="EVENT LOG"
                               Style="{StaticResource SectionHeader}"
                               Margin="0"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource SurfaceRaisedBg}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,1,0,0"
                    Padding="10">
                <Button Content="Clear Log"
                        HorizontalAlignment="Stretch"
                        FontSize="12"
                        Command="{Binding Log.ClearCommand}"
                        AutomationProperties.Name="Clear event log"/>
            </Border>

            <ScrollViewer x:Name="LogScroll"
                          Background="{DynamicResource LogBg}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="12,8">
                <ItemsControl ItemsSource="{Binding Log.Entries}"
                              AutomationProperties.Name="Event log output">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap"
                                       FontFamily="Cascadia Code, Consolas, monospace"
                                       FontSize="11"
                                       LineHeight="16"
                                       Margin="0,1">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource LogFg}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource LogErrorFg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="{Binding Timestamp, Mode=OneWay}"
                                     Foreground="{DynamicResource LogTimestampFg}"/><Run Text="  "/><Run Text="{Binding Message, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
