<UserControl x:Class="RGDSCapture.Views.Controls.CapturePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Right column. DataContext: MainViewModel.
        Everything here is "what you do while playing" — capture, replay,
        audio monitoring, the run timer. Setup lives in DevicePanel.
    -->

    <UserControl.Resources>
        <!--
            Each record button watches a different flag, so the active-fill
            trigger has to be declared per button rather than in the shared
            style. Base look comes from RecordButton.
        -->
        <Style x:Key="RecTopButton" TargetType="Button"
               BasedOn="{StaticResource RecordButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Top.IsRecording}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RecordingBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource RecordingBorder}"/>
                    <Setter Property="Foreground" Value="{DynamicResource RecordingFg}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecBottomButton" TargetType="Button"
               BasedOn="{StaticResource RecordButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Bottom.IsRecording}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RecordingBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource RecordingBorder}"/>
                    <Setter Property="Foreground" Value="{DynamicResource RecordingFg}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecCombinedButton" TargetType="Button"
               BasedOn="{StaticResource RecordButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCombinedRecording}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RecordingBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource RecordingBorder}"/>
                    <Setter Property="Foreground" Value="{DynamicResource RecordingFg}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AudioToggleButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Audio.IsRunning}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TimerDisplay" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TimerFg}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Timer.IsRunning}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TimerRunningFg}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="12,12,12,12">
        <StackPanel>

            <!-- ══ Record ══════════════════════════════════════════ -->
            <Border Style="{StaticResource SidebarCard}">
                <StackPanel>
                    <TextBlock Text="RECORD" Style="{StaticResource SectionHeader}"/>

                    <Button Style="{StaticResource RecTopButton}"
                            Content="{Binding Top.RecordButtonText}"
                            Command="{Binding Top.ToggleRecordingCommand}"
                            IsEnabled="{Binding IsConnected}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,6"
                            AutomationProperties.Name="Record top screen"
                            ToolTip="Record top screen to MP4 (no re-encoding)"/>

                    <Button Style="{StaticResource RecBottomButton}"
                            Content="{Binding Bottom.RecordButtonText}"
                            Command="{Binding Bottom.ToggleRecordingCommand}"
                            IsEnabled="{Binding IsConnectedDualScreen}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,6"
                            AutomationProperties.Name="Record bottom screen"
                            ToolTip="Record bottom screen to MP4 (no re-encoding)"/>

                    <Button Style="{StaticResource RecCombinedButton}"
                            Content="{Binding CombinedRecordButtonText}"
                            Command="{Binding ToggleCombinedRecordingCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,10"
                            AutomationProperties.Name="Record combined"
                            ToolTip="Record both screens (stacked) + Line-In audio to one MP4"/>

                    <Button Content="Screenshot"
                            Command="{Binding ScreenshotCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            FontSize="12" Padding="10,8"
                            AutomationProperties.Name="Take screenshot"
                            ToolTip="Save a PNG of both screens  (F12)"/>
                </StackPanel>
            </Border>

            <!-- ══ Instant replay ══════════════════════════════════ -->
            <Border Style="{StaticResource SidebarCard}">
                <StackPanel>
                    <TextBlock Text="INSTANT REPLAY" Style="{StaticResource SectionHeader}"/>

                    <Button Content="◀◀  Save Replay"
                            Command="{Binding SaveReplayCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            FontSize="12" Padding="10,8"
                            Margin="0,0,0,6"
                            AutomationProperties.Name="Save instant replay"
                            ToolTip="Save the buffered moments of both screens to MP4  (F9)"/>

                    <Button Content="Save GIF (last 10 s)"
                            Command="{Binding SaveGifCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            FontSize="12" Padding="10,8"
                            Margin="0,0,0,10"
                            AutomationProperties.Name="Save replay as GIF"
                            ToolTip="Save the last 10 seconds as an animated GIF  (F10)"/>

                    <TextBlock Text="Buffer length" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource SegmentTrack}">
                        <UniformGrid Rows="1" Columns="4">
                            <RadioButton Style="{StaticResource SegmentRadio}"
                                         GroupName="Replay" Content="15s"
                                         IsChecked="{Binding IsReplay15, Mode=OneWay}"
                                         Command="{Binding SetReplayLengthCommand}"
                                         CommandParameter="15"/>
                            <RadioButton Style="{StaticResource SegmentRadio}"
                                         GroupName="Replay" Content="30s"
                                         IsChecked="{Binding IsReplay30, Mode=OneWay}"
                                         Command="{Binding SetReplayLengthCommand}"
                                         CommandParameter="30"/>
                            <RadioButton Style="{StaticResource SegmentRadio}"
                                         GroupName="Replay" Content="60s"
                                         IsChecked="{Binding IsReplay60, Mode=OneWay}"
                                         Command="{Binding SetReplayLengthCommand}"
                                         CommandParameter="60"/>
                            <RadioButton Style="{StaticResource SegmentRadio}"
                                         GroupName="Replay" Content="120s"
                                         IsChecked="{Binding IsReplay120, Mode=OneWay}"
                                         Command="{Binding SetReplayLengthCommand}"
                                         CommandParameter="120"/>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ══ Audio ═══════════════════════════════════════════ -->
            <Border Style="{StaticResource SidebarCard}">
                <StackPanel>
                    <TextBlock Text="AUDIO" Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="Input (Line-In)" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Audio.InputDevices}"
                              SelectedItem="{Binding Audio.SelectedInput}"
                              Margin="0,0,0,10"
                              AutomationProperties.Name="Audio input device"
                              ToolTip="Select the Line-In / audio input device"/>

                    <TextBlock Text="Output" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Audio.OutputDevices}"
                              SelectedItem="{Binding Audio.SelectedOutput}"
                              Margin="0,0,0,10"
                              AutomationProperties.Name="Audio output device"
                              ToolTip="Select the audio output device"/>

                    <Button Style="{StaticResource AudioToggleButton}"
                            Content="{Binding Audio.ToggleText}"
                            Command="{Binding Audio.ToggleCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,12"
                            AutomationProperties.Name="Start or stop audio passthrough"
                            ToolTip="Start / stop Line-In audio passthrough"/>

                    <!-- Volume + stereo level meters -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <DockPanel Margin="0,0,0,3" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="Volume"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0"/>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding Audio.VolumeLabel}"
                                           Style="{StaticResource ValueText}"/>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="1"
                                    Value="{Binding Audio.Volume}"
                                    AutomationProperties.Name="Volume"
                                    ToolTip="Output volume"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="7" Height="34"
                                Background="{DynamicResource VuBg}"
                                BorderBrush="{DynamicResource VuBorder}"
                                BorderThickness="1" CornerRadius="3"
                                VerticalAlignment="Bottom"
                                Margin="12,0,3,0"
                                ToolTip="Left channel level"
                                AutomationProperties.Name="Left channel level">
                            <Rectangle Fill="{Binding Audio.VuBrush}"
                                       VerticalAlignment="Bottom"
                                       Height="32"
                                       RadiusX="2" RadiusY="2"
                                       RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleY="{Binding Audio.LeftLevel}"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Border>

                        <Border Grid.Column="2"
                                Width="7" Height="34"
                                Background="{DynamicResource VuBg}"
                                BorderBrush="{DynamicResource VuBorder}"
                                BorderThickness="1" CornerRadius="3"
                                VerticalAlignment="Bottom"
                                ToolTip="Right channel level"
                                AutomationProperties.Name="Right channel level">
                            <Rectangle Fill="{Binding Audio.VuBrush}"
                                       VerticalAlignment="Bottom"
                                       Height="32"
                                       RadiusX="2" RadiusY="2"
                                       RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleY="{Binding Audio.RightLevel}"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ Run timer ═══════════════════════════════════════ -->
            <Border Style="{StaticResource SidebarCard}">
                <StackPanel>
                    <TextBlock Text="RUN TIMER" Style="{StaticResource SectionHeader}"/>

                    <Border Background="{DynamicResource TimerBg}"
                            BorderBrush="{DynamicResource TimerBorder}"
                            BorderThickness="1" CornerRadius="7"
                            Padding="10,10"
                            Margin="0,0,0,10">
                        <TextBlock Text="{Binding Timer.Display}"
                                   Style="{StaticResource TimerDisplay}"
                                   FontFamily="Cascadia Code, Consolas, monospace"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   AutomationProperties.Name="Speedrun timer"/>
                    </Border>

                    <Button Content="{Binding Timer.StartPauseText}"
                            Command="{Binding Timer.StartPauseCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,6"
                            AutomationProperties.Name="Start or pause timer"
                            ToolTip="Start / pause the timer  (Space)"/>

                    <UniformGrid Rows="1" Columns="2">
                        <Button Content="⚑  Lap"
                                Command="{Binding Timer.LapCommand}"
                                Margin="0,0,4,0"
                                FontSize="12" Padding="4,7"
                                AutomationProperties.Name="Record lap"
                                ToolTip="Record a lap split to the event log"/>
                        <Button Content="✕  Reset"
                                Command="{Binding Timer.ResetCommand}"
                                Margin="4,0,0,0"
                                FontSize="12" Padding="4,7"
                                AutomationProperties.Name="Reset timer"
                                ToolTip="Reset the timer to zero"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
