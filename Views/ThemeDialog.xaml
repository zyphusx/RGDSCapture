<Window x:Class="RGDSCapture.Views.ThemeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theme"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- One preset tile: a miniature of the theme it applies. -->
        <Style x:Key="ThemeTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
        </Style>

        <ItemsPanelTemplate x:Key="TileRow">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>

        <!-- One shelf per group. Horizontal, so twenty-three themes cannot
             push the dialog taller than the screen; the wheel is remapped to
             scroll sideways in code-behind. -->
        <Style x:Key="TileShelf" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <!--
            Shared by every section. The preview is either a miniature of the
            app's surfaces, or — for a pride theme — the flag itself, so the
            tile is recognisable rather than just "a purple one".
        -->
        <DataTemplate x:Key="ThemeTileTemplate">
            <Button Style="{StaticResource ThemeTile}"
                    Command="{Binding ApplyCommand}"
                    ToolTip="{Binding Name}"
                    AutomationProperties.Name="{Binding Name}">
                <StackPanel>
                    <Grid Height="52">
                        <!-- Plain theme: surface ground, raised bar, accent dot -->
                        <Border Background="{Binding SurfaceSwatch}"
                                CornerRadius="6,6,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasStripes}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid Margin="8">
                                <Border Background="{Binding RaisedSwatch}"
                                        CornerRadius="3" Height="8"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Stretch"/>
                                <Ellipse Fill="{Binding AccentSwatch}"
                                         Width="16" Height="16"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Bottom"/>
                                <Border Background="{Binding TextSwatch}"
                                        CornerRadius="2" Height="5" Width="42"
                                        Opacity="0.55"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>

                        <!-- Pride theme: the flag -->
                        <Border Background="{Binding StripeSwatch}"
                                CornerRadius="6,6,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasStripes}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>

                    <Border CornerRadius="0,0,6,6" Padding="8,6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"
                                        Value="{DynamicResource SurfaceRaisedBg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource AccentMuted}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding Name}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource AccentSubtleFg}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="✓"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Foreground="{DynamicResource AccentSubtleFg}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBg}"
            BorderBrush="{DynamicResource BorderStrong}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <StackPanel Margin="22">

            <!-- Header doubles as the drag handle -->
            <Border x:Name="DragHandle" Background="Transparent" Margin="0,0,0,18">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Theme"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Pick a preset, or set your own accent colour."
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource IconButton}"
                            Content="✕"
                            Click="BtnClose_Click"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Close"/>
                </DockPanel>
            </Border>

            <TextBlock Text="DARK" Style="{StaticResource SectionHeader}"/>
            <ScrollViewer Style="{StaticResource TileShelf}" PreviewMouseWheel="Shelf_MouseWheel">
                <ItemsControl ItemsSource="{Binding DarkThemes}"
                              ItemsPanel="{StaticResource TileRow}"
                              ItemTemplate="{StaticResource ThemeTileTemplate}"/>
            </ScrollViewer>

            <TextBlock Text="LIGHT" Style="{StaticResource SectionHeader}" Margin="0,8,0,10"/>
            <ScrollViewer Style="{StaticResource TileShelf}" PreviewMouseWheel="Shelf_MouseWheel">
                <ItemsControl ItemsSource="{Binding LightThemes}"
                              ItemsPanel="{StaticResource TileRow}"
                              ItemTemplate="{StaticResource ThemeTileTemplate}"/>
            </ScrollViewer>

            <TextBlock Text="PRIDE" Style="{StaticResource SectionHeader}" Margin="0,8,0,10"/>
            <ScrollViewer Style="{StaticResource TileShelf}" PreviewMouseWheel="Shelf_MouseWheel">
                <ItemsControl ItemsSource="{Binding PrideThemes}"
                              ItemsPanel="{StaticResource TileRow}"
                              ItemTemplate="{StaticResource ThemeTileTemplate}"/>
            </ScrollViewer>

            <Border Style="{StaticResource CardDivider}" Margin="0,12"/>

            <!-- ══ Custom accent ═══════════════════════════════════════ -->
            <TextBlock Text="CUSTOM ACCENT" Style="{StaticResource SectionHeader}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="R" Style="{StaticResource SectionLabel}" Margin="0"/>
                        <Slider x:Name="SldR" Grid.Column="1" Minimum="0" Maximum="255"
                                ValueChanged="Channel_Changed"
                                AutomationProperties.Name="Red"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Value, ElementName=SldR, StringFormat={}{0:F0}}"
                                   Style="{StaticResource ValueText}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="G" Style="{StaticResource SectionLabel}" Margin="0"/>
                        <Slider x:Name="SldG" Grid.Column="1" Minimum="0" Maximum="255"
                                ValueChanged="Channel_Changed"
                                AutomationProperties.Name="Green"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Value, ElementName=SldG, StringFormat={}{0:F0}}"
                                   Style="{StaticResource ValueText}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="B" Style="{StaticResource SectionLabel}" Margin="0"/>
                        <Slider x:Name="SldB" Grid.Column="1" Minimum="0" Maximum="255"
                                ValueChanged="Channel_Changed"
                                AutomationProperties.Name="Blue"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Value, ElementName=SldB, StringFormat={}{0:F0}}"
                                   Style="{StaticResource ValueText}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2" Width="132">
                    <Border x:Name="AccentPreview"
                            Height="58"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource BorderStrong}"
                            BorderThickness="1"
                            Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtHex"
                             FontFamily="Cascadia Code, Consolas, monospace"
                             TextAlignment="Center"
                             KeyDown="Hex_KeyDown"
                             LostFocus="Hex_Commit"
                             AutomationProperties.Name="Accent hex value"
                             ToolTip="Type a #RRGGBB value and press Enter"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Content="Apply Accent"
                        Style="{StaticResource AccentButton}"
                        Click="BtnApplyAccent_Click"
                        Margin="0,0,8,0"
                        ToolTip="Re-tint the current theme around this colour"/>
                <Button Content="Use Preset Accent"
                        Click="BtnClearAccent_Click"
                        ToolTip="Drop the custom colour and go back to the preset's own accent"/>
                <Button Content="Done"
                        Width="92"
                        HorizontalAlignment="Right"
                        IsDefault="True"
                        Click="BtnClose_Click"
                        Margin="8,0,0,0"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
